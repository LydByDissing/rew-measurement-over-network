[Unit]
Description=CamillaDSP Audio Processor
Documentation=https://github.com/HEnquist/camilladsp
After=network.target mediamtx.service
Wants=mediamtx.service

[Service]
Type=simple
User=pi
Group=audio
ExecStart=/home/pi/rew-receiver/camilladsp -v -p 1234 /home/pi/rew-receiver/camilladsp.yml
WorkingDirectory=/home/pi/rew-receiver
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security settings (relaxed for Pi compatibility)
NoNewPrivileges=yes
ProtectSystem=no
ProtectHome=no
PrivateTmp=yes

# Resource limits for Pi Zero
MemoryMax=64M
CPUQuota=30%

# Audio access
SupplementaryGroups=audio

[Install]
WantedBy=multi-user.target
[Unit]
Description=UDP to ALSA Audio Bridge for REW
After=sound.target camilladsp.service
Requires=camilladsp.service
PartOf=camilladsp.service

[Service]
Type=exec
User=pi
Group=pi
WorkingDirectory=/home/pi/rew-receiver
ExecStart=/home/pi/rew-receiver/udp-to-alsa.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Environment
Environment="UDP_PORT=8000"
Environment="ALSA_DEVICE=plughw:CARD=Loopback,DEV=0"
Environment="SAMPLE_RATE=48000"
Environment="CHANNELS=2"

[Install]
WantedBy=multi-user.target
